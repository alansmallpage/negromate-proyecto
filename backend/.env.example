# Copia este archivo como .env y rellena los valores (el .env no se sube a git)

# Puerto del servidor
PORT=3000

# MongoDB Atlas
DB_USER=
DB_PASS=
CLUSTER=cluster0.xxxxx.mongodb.net
DATABASE=negromate

# Clave secreta para firmar los tokens JWT
JWT_SECRET=

# Contraseña del usuario admin que crea "npm run create-admin"
ADMIN_PASSWORD=
